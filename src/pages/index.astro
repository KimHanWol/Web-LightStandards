---
import Layout from '../layouts/Layout.astro';
import { getArticles, readingTime, formatPublishedDate } from '../lib/articles.mjs';
import topicMap from '../../config/topic-map.json';
import AffiliateBanner from '../components/AffiliateBanner.astro';
const articles=getArticles();
const mapped=new Map(topicMap.articles.map(topic=>[topic.articleId,topic]));
const topics=articles.map(article=>({article,topic:mapped.get(article.articleId),label:mapped.get(article.articleId)?.aliases[0]||article.title})).sort((a,b)=>a.label.localeCompare(b.label,'ko'));
---
<Layout>
  <div class="feed-shell wrap">
    {articles.length>0&&<section id="topics" class="home-discovery" aria-labelledby="discovery-title">
      <div class="discovery-heading"><h1 id="discovery-title">궁금한 내용을 찾아보세요</h1><p>주제로 살펴보거나 검색으로 필요한 글을 찾아보세요.</p></div>
      <h2 class="topic-list-title">주제로 찾기</h2>
      <div class="home-topic-list">{topics.map(({article,topic,label})=><a class="home-topic-link" href={`/notes/${article.articleId}/`}>
        <div><h3>{label}</h3><p>{topic?.scope||article.description}</p></div><span aria-hidden="true">↗</span>
      </a>)}</div>
    </section>}
    <section id="articles" class="feed-main" aria-labelledby="feed-title">
      <div class="feed-heading"><div><h2 id="feed-title">최근 올라온 글</h2></div><div class="feed-heading-links"><p id="feed-count">전체 {articles.length}개의 글</p><a href="/?view=all#articles" id="feed-all-link">전체 글 보기 <span aria-hidden="true">→</span></a></div></div>
      <div class="feed-grid">{articles.map((article,index)=><>
        <a class:list={['feed-card',{'feed-card-lead':index===0}]} href={`/notes/${article.articleId}/`} data-article data-category={article.category} data-search={`${article.title} ${article.description} ${(mapped.get(article.articleId)?.aliases||[]).join(' ')} ${mapped.get(article.articleId)?.scope||''}`}>
        <div class:list={['feed-image',{'no-image':!article.images[0]?.localPath}]}><img src={article.images[0]?.localPath||'/brand/lightstandards-mark-v2.png'} alt={article.images[0]?.alt||''} width={article.images[0]?.localPath?1024:256} height={article.images[0]?.localPath?768:256} loading={index===0?'eager':'lazy'} decoding="async"/></div>
        <div class="feed-card-copy"><p class="feed-category">{article.category}</p><h3>{article.title}</h3><p class="feed-summary">{article.description}</p><div class="feed-meta"><time datetime={article.publishedAt}>{formatPublishedDate(article.publishedAt).replaceAll('-','.')}</time><span>{readingTime(article)}분 읽기</span></div></div>
        </a>
        {index===Math.min(4,articles.length-1)&&<div class="feed-ad" data-feed-ad><AffiliateBanner slot="home-middle"/></div>}
      </>)}</div>
      {articles.length===0&&<div id="feed-initial-empty" class="feed-empty">
        <div class="empty-illustration" aria-hidden="true"><div class="empty-sheet"><img src="/brand/lightstandards-mark-v2.png" alt="" width="46" height="46"/><span></span><span></span><span></span></div><div class="empty-index"></div></div>
        <h2>아직 발행된 글이 없습니다.</h2><p>새 글이 올라오면 이곳에서 확인할 수 있습니다.</p>
      </div>}
      <p id="feed-empty-search" class="feed-no-results" role="status" aria-live="polite" hidden>검색 결과가 없습니다. 다른 검색어를 입력해 주세요.</p>
    </section>
  </div>
</Layout>
<script>
  const cards=[...document.querySelectorAll<HTMLElement>('[data-article]')];
  const params=new URLSearchParams(window.location.search);
  const query=(params.get('q')||'').trim().toLowerCase();
  const requestedCategory=params.get('category')||'전체';
  const validCategories=new Set(cards.map(card=>card.dataset.category));
  const category=validCategories.has(requestedCategory)?requestedCategory:'전체';
  const filtered=Boolean(query)||category!=='전체';
  const allMode=filtered||params.get('view')==='all';
  const input=document.querySelector<HTMLInputElement>('.site-search input');
  if(input)input.value=params.get('q')||'';
  let visible=0;
  cards.forEach((card,index)=>{
    const match=(allMode||index<6)&&(category==='전체'||card.dataset.category===category)&&(card.dataset.search||'').toLowerCase().includes(query);
    card.hidden=!match;if(match)visible++;
  });
  document.querySelectorAll<HTMLElement>('[data-feed-ad]').forEach(ad=>{ad.hidden=filtered;});
  const count=document.querySelector<HTMLElement>('#feed-count');
  if(count)count.textContent=allMode?`${visible}개의 글`:`최근 ${visible}개 · 전체 ${cards.length}개`;
  const initial=document.querySelector<HTMLElement>('#feed-initial-empty');
  if(initial)initial.hidden=filtered;
  const noResults=document.querySelector<HTMLElement>('#feed-empty-search');
  if(noResults)noResults.hidden=visible>0||!filtered;
  const discovery=document.querySelector<HTMLElement>('.home-discovery');
  if(discovery)discovery.hidden=allMode;
  const allLink=document.querySelector<HTMLElement>('#feed-all-link');
  if(allLink)allLink.hidden=allMode;
  const title=document.querySelector<HTMLElement>('#feed-title');
  if(title)title.textContent=query?'검색 결과':category!=='전체'?category:allMode?'전체 글':'최근 올라온 글';
  document.querySelectorAll<HTMLElement>('.site-navigation a').forEach(link=>{
    if(link.closest('.navigation-info'))return;
    const url=new URL(link.getAttribute('href')||'/',window.location.origin);
    link.classList.toggle('active',url.searchParams.get('view')==='all'?allMode:!allMode&&url.hash!=='#topics');
  });
</script>
