---
import Layout from '../layouts/Layout.astro';
import { getArticles, readingTime, categories } from '../lib/articles.mjs';
import AffiliateBanner from '../components/AffiliateBanner.astro';
const articles=getArticles();
const groups=categories.filter(category=>category!=='전체').map(category=>({category,articles:articles.filter(article=>article.category===category).slice(0,4)}));
---
<Layout>
  <div class="home-ad"><div class="wrap"><AffiliateBanner slot="home-top"/></div></div>
  <div class="feed-shell wrap">
    <section id="articles" class="feed-main" aria-labelledby="feed-title">
      <div class="feed-heading"><h1 id="feed-title">최신 글</h1><p>최근에 발행된 글</p></div>
      <div class="feed-grid">{articles.map(article=><a class="feed-card" href={`/notes/${article.articleId}/`} data-article data-category={article.category} data-search={`${article.title} ${article.description}`}>
        <div class:list={['feed-image',{'no-image':!article.images[0]?.localPath}]}><img src={article.images[0]?.localPath||'/brand/lightstandards-mark.png'} alt={article.images[0]?.alt||''} width={article.images[0]?.localPath?1024:256} height={article.images[0]?.localPath?768:256} loading="lazy" decoding="async"/></div>
        <div class="feed-card-copy"><p class="feed-category">{article.category}</p><h2>{article.title}</h2><p class="feed-summary">{article.description}</p><div class="feed-meta"><time datetime={article.publishedAt}>{article.publishedAt.slice(0,10).replaceAll('-','.')}</time><span>{readingTime(article)}분 읽기</span></div></div>
      </a>)}</div>
      {articles.length===0&&<div id="feed-initial-empty" class="feed-empty"><h2>아직 발행된 글이 없습니다.</h2><p>글이 발행되면 최신 글과 주제별 목록이 표시됩니다.</p></div>}
      <p id="feed-empty-search" class="feed-no-results" role="status" aria-live="polite" hidden>검색 결과가 없습니다. 다른 검색어를 입력해 주세요.</p>
      {articles.length>=8&&<div id="category-groups">{groups.map(group=><section class="feed-group"><h2><a href={`/?category=${encodeURIComponent(group.category)}#articles`}>{group.category}</a></h2><ul>{group.articles.map(article=><li><a href={`/notes/${article.articleId}/`}>{article.title}</a><time datetime={article.publishedAt}>{article.publishedAt.slice(0,10)}</time></li>)}</ul></section>)}</div>}
      <AffiliateBanner slot="home-middle"/><AffiliateBanner slot="home-bottom"/>
    </section>
    <aside class="feed-sidebar" aria-label="광고"><div class="feed-sidebar-inner"><AffiliateBanner slot="home-sidebar"/></div></aside>
  </div>
</Layout>
<script>
  const cards=[...document.querySelectorAll<HTMLElement>('[data-article]')];
  const params=new URLSearchParams(window.location.search);
  const query=(params.get('q')||'').trim().toLowerCase();
  const requestedCategory=params.get('category')||'전체';
  const validCategories=new Set(cards.map(card=>card.dataset.category));
  const category=validCategories.has(requestedCategory)?requestedCategory:'전체';
  const input=document.querySelector<HTMLInputElement>('.site-search input');
  if(input)input.value=params.get('q')||'';
  let visible=0;
  cards.forEach(card=>{
    const match=(category==='전체'||card.dataset.category===category)&&(card.dataset.search||'').toLowerCase().includes(query);
    card.hidden=!match;if(match)visible++;
  });
  const filtered=Boolean(query)||category!=='전체';
  const initial=document.querySelector<HTMLElement>('#feed-initial-empty');
  if(initial)initial.hidden=filtered;
  const noResults=document.querySelector<HTMLElement>('#feed-empty-search');
  if(noResults)noResults.hidden=visible>0||!filtered;
  const groups=document.querySelector<HTMLElement>('#category-groups');
  if(groups)groups.hidden=filtered;
  const title=document.querySelector<HTMLElement>('#feed-title');
  if(title)title.textContent=query?'검색 결과':category==='전체'?'최신 글':category;
  document.querySelectorAll<HTMLElement>('.site-navigation a').forEach(link=>{
    if(link.closest('.navigation-info'))return;
    const linkCategory=new URL(link.getAttribute('href')||'/',window.location.origin).searchParams.get('category')||'전체';
    link.classList.toggle('active',linkCategory===category);
  });
</script>
