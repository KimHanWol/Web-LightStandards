---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site.mjs';
import { bannersEnabled } from '../lib/banners.mjs';
const pages = {
  contact:{title:'문의와 오류 제보',eyebrow:'CONTACT',paragraphs:['글에서 잘못된 정보나 설명이 부족한 부분을 발견하셨다면 알려주세요. 해당 글 주소와 확인이 필요한 내용을 함께 보내주시면 자료를 다시 살펴보겠습니다.','주민등록번호, 결제 정보, 비밀번호 등 민감한 정보는 보내지 마세요. 광고·제휴 문의도 같은 창구로 받습니다.']},
  about:{title:'소소한 기준 소개',eyebrow:'ABOUT LIGHTSTANDARDS',paragraphs:['소소한 기준은 다양한 주제의 질문과 정보를 다루는 블로그입니다. 발행된 글은 검색과 주제별 목록에서 찾아볼 수 있습니다.','문의와 정보 수정 요청은 아래 연락 창구로 보내주세요. 일부 글과 설명 이미지 제작에는 AI 도구를 사용할 수 있습니다.']},
  privacy:{title:'개인정보처리방침',eyebrow:'PRIVACY',paragraphs:['현재 사이트에는 회원가입과 댓글 입력 기능이 없습니다. 사이트 제공 과정에서 호스팅 제공자가 접속 IP, 요청 시각 등 기술 로그를 처리할 수 있습니다.','문의 이메일을 보내면 회신에 필요한 발신 주소와 문의 내용을 처리합니다. 문의 해결 후 법령상 보존이 필요한 경우를 제외하고 지체 없이 삭제하는 것을 원칙으로 합니다.',bannersEnabled?'이 사이트는 쿠팡 파트너스 추천 배너를 사용합니다. 배너를 불러오거나 클릭하면 쿠팡의 외부 서비스로 요청이 전송되며, 해당 서비스에서 쿠키와 접속·광고 이용 정보를 처리할 수 있습니다. 이 사이트에는 해당 정보가 별도로 저장되지 않습니다. 쿠키 허용 여부는 브라우저 설정에서 변경할 수 있습니다. 쿠팡의 개인정보 처리에 관한 자세한 내용은 아래 정책을 확인해 주세요.':'현재 쿠팡 배너는 비활성 상태입니다.','별도 방문 분석은 현재 비활성 상태입니다. 다른 광고·분석 서비스를 추가할 때는 제공자와 처리 내용, 이용자 선택 방법을 이 페이지에 반영합니다.']},
  disclosure:{title:'광고와 제휴를 안내합니다.',eyebrow:'ADVERTISING & AFFILIATES',paragraphs:[bannersEnabled?'소소한 기준은 쿠팡 파트너스 배너를 통해 운영 수익을 얻을 수 있습니다. 배너에는 경제적 관계를 표시합니다.':'소소한 기준은 향후 광고와 제휴 링크를 통해 운영 수익을 얻을 수 있습니다. 현재 쿠팡 배너는 비활성 상태입니다.','쿠팡 파트너스 링크가 포함된 글은 첫 부분에 경제적 관계를 공개합니다. 독자가 링크를 통해 구매하면 사이트에 일정액의 수수료가 지급될 수 있습니다.','추천 배너의 상품은 쿠팡에서 제공하며 방문자마다 다르게 표시될 수 있습니다. 배너 노출은 사이트의 개별 상품 추천이나 사용 경험을 뜻하지 않습니다.','상품 가격·재고·배송 조건은 판매처에서 확인해 주세요. 광고나 제휴 관계가 제품의 성능과 적합성을 보장하지는 않습니다.']}
};
export function getStaticPaths(){return ['about','contact','privacy','disclosure'].map(page=>({params:{page}}));}
const page=pages[Astro.params.page as keyof typeof pages];
---
<Layout title={page.title}><section class="information-page wrap"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><div class="information-copy">{page.paragraphs.map(p=><p>{p}</p>)}{Astro.params.page==='contact'&&<section><h2>이메일로 보내기</h2>{site.email?<a href={`mailto:${site.email}`}>{site.email}</a>:<p>문의 창구를 준비하고 있습니다.</p>}</section>}{Astro.params.page==='privacy'&&bannersEnabled&&<p><a href="https://privacy.coupang.com/ko/center/coupang/" target="_blank" rel="noopener noreferrer">쿠팡 개인정보처리방침 ↗</a></p>}{Astro.params.page==='about'&&<a href="/contact/">문의와 오류 제보 →</a>}</div><a class="back-link" href="/">← 소소한 기준으로 돌아가기</a></section></Layout>
