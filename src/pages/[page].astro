---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site.mjs';
const pages = {
  contact:{title:'문의와 오류 제보',eyebrow:'CONTACT',paragraphs:['글에서 잘못된 정보나 설명이 부족한 부분을 발견하셨다면 알려주세요. 해당 글 주소와 확인이 필요한 내용을 함께 보내주시면 자료를 다시 살펴보겠습니다.','주민등록번호, 결제 정보, 비밀번호 등 민감한 정보는 보내지 마세요. 광고·제휴 문의도 같은 창구로 받습니다.']},
  about:{title:'작은 선택에, 좋은 기준을.',eyebrow:'ABOUT LIGHTSTANDARDS',paragraphs:['소소한 기준는 생활 도구와 디지털 기기, 공간을 더 잘 이해하기 위한 기록입니다. 제품 이름을 많이 모으기보다, 어떤 조건에서 어떤 선택이 필요한지를 살펴봅니다.','제품 사양과 공개 자료를 확인한 설명을 제공하며, 직접 사용한 경험이 있는 경우 그 범위를 구체적으로 밝힙니다.']},
  editorial:{title:'추천보다 먼저, 이유를 씁니다.',eyebrow:'EDITORIAL PRINCIPLES',paragraphs:['확인한 사실에는 출처와 확인 시점을 남깁니다. 변경 가능성이 있는 가격·재고 정보는 판매 페이지에서 다시 확인하도록 안내합니다.','직접 측정하거나 사용하지 않은 결과를 체험담으로 쓰지 않습니다. 자료를 바탕으로 한 비교와 실제 사용 경험을 명확하게 구분합니다.','AI는 자료 정리와 초안 작성, 설명 이미지 제작을 도울 수 있습니다. 게시 전에는 내용과 출처를 검토하며, 생성 이미지를 실물 사진이나 성능 증거로 제시하지 않습니다.','광고·제휴 관계가 있는 글에는 이를 표시합니다. 오류가 확인되면 내용을 수정하고 확인 시점을 갱신합니다.']},
  privacy:{title:'개인정보처리방침',eyebrow:'PRIVACY',paragraphs:['현재 사이트에는 회원가입과 댓글 입력 기능이 없습니다. 사이트 제공 과정에서 호스팅 제공자가 접속 IP, 요청 시각 등 기술 로그를 처리할 수 있습니다.','문의 이메일을 보내면 회신에 필요한 발신 주소와 문의 내용을 처리합니다. 문의 해결 후 법령상 보존이 필요한 경우를 제외하고 지체 없이 삭제하는 것을 원칙으로 합니다.','현재 광고와 별도 방문 분석은 비활성 상태입니다. 향후 광고·분석 서비스를 도입할 때 처리 항목, 제공자, 쿠키 및 이용자 선택 방법을 이 페이지에 반영한 뒤 활성화합니다.']},
  disclosure:{title:'광고와 제휴를 안내합니다.',eyebrow:'ADVERTISING & AFFILIATES',paragraphs:['소소한 기준는 향후 광고와 제휴 링크를 통해 운영 수익을 얻을 수 있습니다. 현재 광고 코드와 상품 제휴 링크는 등록되어 있지 않습니다.','쿠팡 파트너스 링크가 포함된 글은 첫 부분에 경제적 관계를 공개합니다. 독자가 링크를 통해 구매하면 사이트에 일정액의 수수료가 지급될 수 있습니다.','상품 가격·재고·배송 조건은 판매처에서 확인해 주세요. 광고나 제휴 관계가 제품의 성능과 적합성을 보장하지는 않습니다.']}
};
export function getStaticPaths(){return ['about','contact','editorial','privacy','disclosure'].map(page=>({params:{page}}));}
const page=pages[Astro.params.page as keyof typeof pages];
---
<Layout title={page.title}><section class="information-page wrap"><p class="eyebrow">{page.eyebrow}</p><h1>{page.title}</h1><div class="information-copy">{page.paragraphs.map(p=><p>{p}</p>)}{Astro.params.page==='contact'&&<section><h2>이메일로 보내기</h2>{site.email?<a href={`mailto:${site.email}`}>{site.email}</a>:<p>문의 창구를 준비하고 있습니다.</p>}</section>}{Astro.params.page==='about'&&<a href="/contact/">문의와 오류 제보 →</a>}</div><a class="back-link" href="/">← 소소한 기준로 돌아가기</a></section></Layout>
