---
import '../styles/pretendard.css';
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/publication.css';
import '../styles/magazine.css';
import { site } from '../lib/site.mjs';
import { sections } from '../lib/navigation.mjs';
import searchVerification from '../../config/search-verification.json';
const {title=site.name,description=site.description,noindex=false,image='/brand/lightstandards-mark-v2.png'}=Astro.props;
const canonical=new URL(Astro.url.pathname,site.url).href;
const googleVerification=import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION||searchVerification.google;
const naverVerification=import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION||searchVerification.naver;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title===site.name?site.name:`${title} | ${site.name}`}</title>
    <meta name="description" content={description}/><meta name="theme-color" content="#ffffff"/>
    <meta name="robots" content={noindex||!site.ready?'noindex, nofollow':'index, follow'}/>
    <link rel="canonical" href={canonical}/><link rel="icon" href="/brand/favicon-v2.png?v=3" type="image/png"/>
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon-v2.png?v=3"/>
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>
    <meta property="og:locale" content="ko_KR"/><meta property="og:site_name" content={site.name}/>
    <meta property="og:image" content={new URL(image,site.url).href}/>
    {googleVerification&&<meta name="google-site-verification" content={googleVerification}/>}
    {naverVerification&&<meta name="naver-site-verification" content={naverVerification}/>}
    <slot name="head"/>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="소소한 기준 홈"><img class="brand-symbol" src="/brand/lightstandards-mark-v2.png?v=3" alt="" width="36" height="36"/><span class="brand-type">소소한 기준</span></a>
      <form class="site-search" method="get" action="/#articles" role="search">
        <input type="search" name="q" placeholder="궁금한 내용을 검색하세요" aria-label="글 검색"/>
        <button type="submit" aria-label="검색"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
      </form>
    </header>
    <nav class="site-navigation" aria-label="주 메뉴"><div class="wrap">
      <a href="/" class={Astro.url.pathname==='/'?'active':''}>홈</a>
      {sections.map(section=><a href={`/categories/${section.id}/`} class={Astro.url.pathname===`/categories/${section.id}/`?'active':''}>{section.label}</a>)}
      <a href="/?view=all#articles">전체 글</a>
      <div class="navigation-info"><a href="/about/">소개</a><a href="/contact/">문의</a></div>
    </div></nav>
    <main id="main"><slot/></main>
    <footer class="site-footer wrap">
      <div><a href="/" class="footer-brand"><img src="/brand/lightstandards-mark-v2.png?v=3" alt="" width="32" height="32"/>소소한 기준</a><p>LIGHTSTANDARDS</p></div>
      <div class="footer-links"><a href="/about/">소개</a><a href="/contact/">문의</a><a href="/privacy/">개인정보처리방침</a><a href="/disclosure/">광고·제휴 안내</a><a href="/rss.xml">RSS</a></div>
      <small>© {new Date().getFullYear()} 소소한 기준</small>
    </footer>
  </body>
</html>
