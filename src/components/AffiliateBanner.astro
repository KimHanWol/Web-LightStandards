---
import { getBanners, bannerDisclosure } from '../lib/banners.mjs';
const { slot, category }=Astro.props;
const banners=getBanners(slot,category);
---
{banners.map(banner=><aside class="affiliate-banner" aria-label="쿠팡 파트너스 광고" data-banner-slot={slot} data-responsive={Boolean(banner.mobile)} style={`--banner-content-width:${banner.desktop.width}px;--banner-mobile-width:${banner.mobile?.width||banner.desktop.width}px`}>
  <div class="banner-label"><span>광고 · 쿠팡 파트너스</span></div>
  {banner.type==='dynamic' ? <div class="dynamic-banner-frame" data-responsive={Boolean(banner.mobile&&banner.desktop.width>=728)} style={`--desktop-width:${banner.desktop.width}px;--desktop-ratio:${banner.desktop.width}/${banner.desktop.height};--mobile-width:${banner.mobile?.width||banner.desktop.width}px;--mobile-ratio:${banner.mobile?.width||banner.desktop.width}/${banner.mobile?.height||banner.desktop.height}`}>
    <div class="dynamic-banner-mount" data-coupang-widget={JSON.stringify({widget:banner.widget,mobileWidget:banner.mobileWidget,desktop:banner.desktop,mobile:banner.mobile})}></div>
    <noscript>추천 상품 광고는 JavaScript를 켜면 표시됩니다.</noscript>
  </div> : <a href={banner.href} target="_blank" rel="sponsored noopener noreferrer" aria-label={`${banner.alt} — 쿠팡에서 확인`}>
    <picture style={`--desktop-ratio:${banner.desktop.width}/${banner.desktop.height};--mobile-ratio:${banner.mobile?.width||banner.desktop.width}/${banner.mobile?.height||banner.desktop.height};--banner-width:${banner.desktop.width}px;--mobile-width:${banner.mobile?.width||banner.desktop.width}px`}>
      {banner.mobile&&<source media="(max-width: 600px)" srcset={banner.mobile.src} width={banner.mobile.width} height={banner.mobile.height}/>}
      <img src={banner.desktop.src} alt={banner.alt} width={banner.desktop.width} height={banner.desktop.height} loading="lazy" decoding="async" />
    </picture>
  </a>}
  <p class="banner-disclosure">{bannerDisclosure}</p>
</aside>)}
<script>
  import { initialiseCoupangBanners } from '../lib/coupang-client.mjs';
  initialiseCoupangBanners();
</script>
