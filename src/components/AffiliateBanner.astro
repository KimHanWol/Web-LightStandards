---
import { getBanners } from '../lib/banners.mjs';
const { slot, category }=Astro.props;
const banners=getBanners(slot,category);
---
{banners.map(banner=><aside class="affiliate-banner" aria-label="쿠팡 파트너스 광고" data-banner-slot={slot}>
  <div class="banner-label"><span>광고 · 쿠팡 파트너스</span><span>↗</span></div>
  <a href={banner.href} target="_blank" rel="sponsored noopener noreferrer" aria-label={`${banner.alt} — 쿠팡에서 확인`}>
    <picture style={`--desktop-ratio:${banner.desktop.width}/${banner.desktop.height};--mobile-ratio:${banner.mobile?.width||banner.desktop.width}/${banner.mobile?.height||banner.desktop.height};--banner-width:${banner.desktop.width}px;--mobile-width:${banner.mobile?.width||banner.desktop.width}px`}>
      {banner.mobile&&<source media="(max-width: 600px)" srcset={banner.mobile.src} width={banner.mobile.width} height={banner.mobile.height}/>}
      <img src={banner.desktop.src} alt={banner.alt} width={banner.desktop.width} height={banner.desktop.height} loading="lazy" decoding="async" />
    </picture>
  </a>
  <p class="banner-disclosure">쿠팡 파트너스 활동으로, 구매 시 일정액의 수수료를 제공받습니다.</p>
</aside>)}
