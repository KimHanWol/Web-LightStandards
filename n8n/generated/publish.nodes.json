  {
    "name": "Read Articles",
    "type": "n8n-nodes-base.dataTable",
    "typeVersion": 1.1,
    "parameters": {
      "resource": "row",
      "operation": "get",
      "dataTableId": {
        "__rl": true,
        "mode": "list",
        "value": "d0S98phwvzjPal6X",
        "cachedResultName": "Blog - 소소한 기준 - Articles"
      },
      "returnAll": true,
      "filters": {
        "conditions": []
      }
    }
  },
  {
    "name": "Select Publication",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "parameters": {
      "mode": "runOnceForAllItems",
      "jsCode": "const c=$('Configuration').first().json;if(!c.enabled)return [];\nif(!/^[\\w.-]+$/.test(c.repo_owner)||!/^[\\w.-]+$/.test(c.repo_name))throw new Error('Configure GitHub repository');\nif(!/^https:\\/\\/[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\\.[a-z]{2,}\\/?$/i.test(c.site_url))throw new Error('Configure HTTPS site origin');\nconst origin=c.site_url.replace(/\\/$/,'');\nconst rows=$input.all().map(i=>i.json);\nconst row=rows.find(r=>r.status==='publishing')||rows.find(r=>r.status==='approved'&&Date.parse(r.scheduled_at)<=Date.now());\nif(!row)return [];\nconst p=JSON.parse(row.publish_payload);const sources=JSON.parse(row.sources_json).map(({title,url,checkedAt})=>({title,url,checkedAt}));\nif(p.articleId!==row.article_id||p.intentKey!==row.intent_key||p.category!==row.category||p.title!==row.title||p.description!==row.description||p.markdown!==row.body_markdown||p.revision!==Number(row.revision)||p.approvedRevision!==Number(row.approved_revision)||p.approvedAt!==row.approved_at||p.approvedBy!==row.approved_by||p.publishedAt!==row.scheduled_at||JSON.stringify(p.sources)!==JSON.stringify(sources)||JSON.stringify(p.images)!==JSON.stringify(JSON.parse(row.images_json))||JSON.stringify(p.affiliates)!==JSON.stringify(JSON.parse(row.affiliate_json||'[]')))throw new Error('Content changed since approval; review the new revision');\nif(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(p.articleId))throw new Error('Invalid article ID');\nreturn [{json:{...row,repo_owner:c.repo_owner,repo_name:c.repo_name,site_url:origin,path:`content/inbox/${p.articleId}-r${p.revision}.json`,public_url:origin+'/notes/'+p.articleId+'/'}}];\n"
    }
  },
  {
    "name": "Awaiting Deployment",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2.3,
    "parameters": {
      "conditions": {
        "options": {
          "caseSensitive": true,
          "leftValue": "",
          "typeValidation": "strict"
        },
        "conditions": [
          {
            "leftValue": "={{ $json.status }}",
            "rightValue": "publishing",
            "operator": {
              "type": "string",
              "operation": "equals"
            }
          }
        ],
        "combinator": "and"
      }
    }
  },
  {
    "name": "Check Live Manifest",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.5,
    "parameters": {
      "method": "GET",
      "url": "={{ $('Select Publication').first().json.site_url+'/publication.json?t='+Date.now() }}",
      "options": {
        "timeout": 30000,
        "redirect": {
          "redirect": {
            "followRedirects": false
          }
        },
        "response": {
          "response": {
            "responseFormat": "json"
          }
        }
      }
    }
  },
  {
    "name": "Confirm Live Revision",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "parameters": {
      "mode": "runOnceForAllItems",
      "jsCode": "const row=$('Select Publication').first().json; const data=$input.first().json; if(!data.articles?.some(a=>a.articleId===row.article_id&&a.revision===Number(row.revision)))return []; return [{json:{...row,status:'published'}}];"
    }
  },
  {
