[
  {
    "name": "Manual Start",
    "type": "n8n-nodes-base.manualTrigger",
    "typeVersion": 1,
    "parameters": {}
  },
  {
    "name": "Hourly Schedule",
    "type": "n8n-nodes-base.scheduleTrigger",
    "typeVersion": 1.4,
    "parameters": {
      "rule": {
        "interval": [
          {
            "field": "hours",
            "hoursInterval": 1,
            "triggerAtMinute": 10
          }
        ]
      }
    }
  },
  {
    "name": "Read Image Requests",
    "type": "n8n-nodes-base.dataTable",
    "typeVersion": 1.1,
    "parameters": {
      "resource": "row",
      "operation": "get",
      "dataTableId": {
        "__rl": true,
        "mode": "list",
        "value": "d0S98phwvzjPal6X",
        "cachedResultName": "Blog - 소소한 기준 - Articles"
      },
      "returnAll": true,
      "filters": {
        "conditions": [
          {
            "keyName": "status",
            "condition": "eq",
            "keyValue": "image_pending"
          }
        ]
      }
    }
  },
  {
    "name": "Select Image Request",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "parameters": {
      "mode": "runOnceForAllItems",
      "jsCode": "for(const item of $input.all()){\n  const r=item.json;if(r.status!=='image_pending'||!r.fal_request_id)continue;\n  const base='https://queue.fal.run/fal-ai/flux/requests/'+r.fal_request_id;\n  if(/^[a-zA-Z0-9-]+$/.test(r.fal_request_id)&&r.fal_status_url===base+'/status'&&r.fal_response_url===base)return [{json:r}];\n}\nreturn [];\n"
    }
  },
  {
    "name": "Read fal Status",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.5,
    "parameters": {
      "method": "GET",
      "url": "={{ $json.fal_status_url }}",
      "authentication": "genericCredentialType",
      "genericAuthType": "httpHeaderAuth",
      "options": {
        "timeout": 30000,
        "redirect": {
          "redirect": {
            "followRedirects": false
          }
        },
        "response": {
          "response": {
            "responseFormat": "json"
          }
        }
      }
    }
  },
  {
    "name": "Images Completed",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2.3,
    "parameters": {
      "conditions": {
        "options": {
          "caseSensitive": true,
          "leftValue": "",
          "typeValidation": "strict"
        },
        "conditions": [
          {
            "leftValue": "={{ $json.status }}",
            "rightValue": "COMPLETED",
            "operator": {
              "type": "string",
              "operation": "equals"
            }
          }
        ],
        "combinator": "and"
      }
    }
  },
  {
    "name": "Read fal Result",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.5,
    "parameters": {
      "method": "GET",
      "url": "={{ $('Select Image Request').first().json.fal_response_url }}",
      "authentication": "genericCredentialType",
      "genericAuthType": "httpHeaderAuth",
      "options": {
        "timeout": 30000,
        "redirect": {
          "redirect": {
            "followRedirects": false
          }
        },
        "response": {
          "response": {
            "responseFormat": "json"
          }
        }
      }
    }
  },
  {
    "name": "Validate Images",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "parameters": {
      "mode": "runOnceForAllItems",
      "jsCode": "const row=$('Select Image Request').first().json;const response=$input.first().json;\nconst images=response.images;\nconst existing=JSON.parse(row.images_json||'[]');\nif(!Array.isArray(existing)||existing.length>=5||!Array.isArray(images)||images.length!==1)throw new Error('Expected one remaining illustration; inspect fal result');\nif(response.has_nsfw_concepts?.some(Boolean))throw new Error('Image safety review required');\nfor(const i of images){if(typeof i.url!=='string'||!/^https:\\/\\/(?:[a-z0-9-]+\\.)*fal\\.media\\/[^\\s\\\\]+$/i.test(i.url))throw new Error('Unexpected image host');}\nif(existing.some(old=>old.url===images[0].url))throw new Error('Image receipt already recorded; do not double count');\nconst combined=[...existing,...images.map((i,n)=>({url:i.url,alt:row.title+' — AI 생성 설명 이미지 '+(existing.length+n+1),generated:true}))];\nreturn [{json:{...row,status:combined.length===5?'needs_review':'image_more_needed',images_json:JSON.stringify(combined),actual_usd:Number(row.actual_usd||0)+0.003,reserved_usd:(5-combined.length)*0.003,error:''}}];\n"
    }
  },
  {
    "name": "Save Review Package",
    "type": "n8n-nodes-base.dataTable",
    "typeVersion": 1.1,
    "parameters": {
      "resource": "row",
      "operation": "update",
      "dataTableId": {
        "__rl": true,
        "mode": "list",
        "value": "d0S98phwvzjPal6X",
        "cachedResultName": "Blog - 소소한 기준 - Articles"
      },
      "matchType": "allConditions",
      "filters": {
        "conditions": [
          {
            "keyName": "id",
            "condition": "eq",
            "keyValue": "={{ $json.id }}"
          }
        ]
      },
      "columns": {
        "mappingMode": "defineBelow",
        "value": {
          "status": "={{ $json.status }}",
          "images_json": "={{ $json.images_json }}",
          "actual_usd": "={{ $json.actual_usd }}",
          "reserved_usd": "={{ $json.reserved_usd }}",
          "error": "={{ $json.error }}"
        },
        "matchingColumns": []
      },
      "options": {}
    }
  },
  {
    "name": "More Images Needed",
    "type": "n8n-nodes-base.if",
    "typeVersion": 2.3,
    "parameters": {
      "conditions": {
        "options": {
          "caseSensitive": true,
          "leftValue": "",
          "typeValidation": "strict"
        },
        "conditions": [
          {
            "leftValue": "={{ $json.status }}",
            "rightValue": "image_more_needed",
            "operator": {
              "type": "string",
              "operation": "equals"
            }
          }
        ],
        "combinator": "and"
      }
    }
  },
  {
    "name": "Reserve Next Image",
    "type": "n8n-nodes-base.dataTable",
    "typeVersion": 1.1,
    "parameters": {
      "resource": "row",
      "operation": "update",
      "dataTableId": {
        "__rl": true,
        "mode": "list",
        "value": "d0S98phwvzjPal6X",
        "cachedResultName": "Blog - 소소한 기준 - Articles"
      },
      "matchType": "allConditions",
      "filters": {
        "conditions": [
          {
            "keyName": "id",
            "condition": "eq",
            "keyValue": "={{ $('Validate Images').first().json.id }}"
          },
          {
            "keyName": "status",
            "condition": "eq",
            "keyValue": "image_more_needed"
          }
        ]
      },
      "columns": {
        "mappingMode": "defineBelow",
        "value": {
          "status": "image_submitting",
          "reserved_usd": "={{ $('Validate Images').first().json.reserved_usd }}"
        },
        "matchingColumns": []
      },
      "options": {}
    }
  },
  {
    "name": "Generate Next Illustration",
    "type": "n8n-nodes-base.httpRequest",
    "typeVersion": 4.5,
    "parameters": {
      "method": "POST",
      "url": "https://queue.fal.run/fal-ai/flux/schnell",
      "authentication": "genericCredentialType",
      "genericAuthType": "httpHeaderAuth",
      "sendBody": true,
      "contentType": "json",
      "specifyBody": "json",
      "jsonBody": "={{ JSON.stringify({prompt: JSON.parse($('Validate Images').first().json.image_prompt)[JSON.parse($('Validate Images').first().json.images_json).length], image_size:{width:1024,height:768},num_images:1,output_format:'png',enable_safety_checker:true}) }}",
      "options": {
        "timeout": 30000,
        "redirect": {
          "redirect": {
            "followRedirects": false
          }
        },
        "response": {
          "response": {
            "responseFormat": "json"
          }
        }
      }
    }
  },
  {
    "name": "Check Next Image Receipt",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "parameters": {
      "mode": "runOnceForAllItems",
      "jsCode": "const row=$('Validate Images').first().json;\nconst response=$input.first().json;\nconst base='https://queue.fal.run/fal-ai/flux/requests/'+response.request_id;\nconst ok=typeof response.request_id==='string'&&/^[a-zA-Z0-9-]+$/.test(response.request_id)&&response.status_url===base+'/status'&&response.response_url===base;\nreturn [{json:{...row,status:ok?'image_pending':'image_uncertain',fal_request_id:ok?response.request_id:'',fal_status_url:ok?response.status_url:'',fal_response_url:ok?response.response_url:'',error:ok?'':'fal request outcome uncertain; inspect execution, do not resubmit automatically'}}];\n"
    }
  },
  {
    "name": "Save Next Image Receipt",
    "type": "n8n-nodes-base.dataTable",
    "typeVersion": 1.1,
    "parameters": {
      "resource": "row",
      "operation": "update",
      "dataTableId": {
        "__rl": true,
        "mode": "list",
        "value": "d0S98phwvzjPal6X",
        "cachedResultName": "Blog - 소소한 기준 - Articles"
      },
      "matchType": "allConditions",
      "filters": {
        "conditions": [
          {
            "keyName": "id",
            "condition": "eq",
            "keyValue": "={{ $json.id }}"
          }
        ]
      },
      "columns": {
        "mappingMode": "defineBelow",
        "value": {
          "status": "={{ $json.status }}",
          "fal_request_id": "={{ $json.fal_request_id }}",
          "fal_status_url": "={{ $json.fal_status_url }}",
          "fal_response_url": "={{ $json.fal_response_url }}",
          "reserved_usd": "={{ $json.reserved_usd }}",
          "error": "={{ $json.error }}"
        },
        "matchingColumns": []
      },
      "options": {}
    }
  }
]